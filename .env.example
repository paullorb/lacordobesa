NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_SITE_URL=https://lacordobesa.vercel.app

# Transactional mail (Resend). Both optional: without them nothing is sent, the staff card shows
# "noch nicht verschickt" and the team confirms by phone or WhatsApp as before. Server-side only,
# so deliberately not NEXT_PUBLIC_.
RESEND_API_KEY=re_...
MAIL_FROM=La Cordobesa <reservierung@your-verified-domain.de>

# Instagram feed on the landing page (optional). Without these the page shows the photos staff
# featured in the gallery instead. Long-lived token from the Instagram Graph API; it expires after
# 60 days and must be refreshed, and an expired token just hides the section.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
