# Point these at the STAGING project (lacordobesa-staging), not the live one. src/lib/supabase/env.ts
# refuses to query production outside the production deployment, so a prod URL here fails on the first
# page load instead of writing into real reservations. See README, "Environments".
NEXT_PUBLIC_SUPABASE_URL=https://<staging-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Set to 1 only for a command that is meant to touch live data (a one-off script, reproducing something
# that only exists in production). Never commit it, never put it in Vercel.
# ALLOW_PRODUCTION_DB=1

# REQUIRED. Server-only secret key (Supabase dashboard: Project Settings, API Keys, "Secret keys"). The
# public forms call their RPCs with it and enforce a per-visitor limit. Migration 20261014072715 revoked
# those five RPCs from anon, so there is no publishable-key fallback left: without this key every public
# form fails to submit. Never prefix it with NEXT_PUBLIC_: it bypasses row-level security.
SUPABASE_SECRET_KEY=

# The site's own absolute URL: sitemap, robots.txt, JSON-LD and every guest management link.
# On Vercel this can be left unset, since NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL is used instead.
# Set it to the custom domain once lacordobesa.de is registered (see the open issue).
NEXT_PUBLIC_SITE_URL=https://lacordobesa.vercel.app

# Transactional mail (Resend). Both optional: without them nothing is sent, the staff card shows
# "noch nicht verschickt" and the team confirms by phone or WhatsApp as before. Server-side only,
# so deliberately not NEXT_PUBLIC_.
RESEND_API_KEY=re_...
MAIL_FROM=La Cordobesa <reservierung@your-verified-domain.de>

# Instagram feed on the landing page (optional). Without these the page shows the photos staff
# featured in the gallery instead. Long-lived token from the Instagram Graph API; it expires after
# 60 days and must be refreshed, and an expired token just hides the section.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Graph API version, optional; the code's default moves with Meta's deprecations.
INSTAGRAM_GRAPH_VERSION=

# A staff login for `npm run test:e2e` and `npm run shots -- --staff`. Staging only, never production.
STAFF_USER=
STAFF_PASS=
