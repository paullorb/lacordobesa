{
  "name": "lacordobesa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "dev": "node scripts/with-local-supabase.mjs next dev",
    "build": "next build",
    "build:local": "node scripts/with-local-supabase.mjs next build",
    "start": "next start",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "node tests/require-node.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/alias-hook.mjs --test \"tests/unit/**/*.test.ts\"",
    "test:unit:coverage": "node tests/require-node.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/alias-hook.mjs --test --experimental-test-coverage \"tests/unit/**/*.test.ts\"",
    "test:integration": "node tests/require-node.mjs && node scripts/with-local-supabase.mjs node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/alias-hook.mjs --test --test-concurrency=1 \"tests/integration/**/*.test.mjs\"",
    "test:e2e": "node scripts/with-local-supabase.mjs node --test --test-concurrency=2 \"tests/e2e/**/*.test.mjs\"",
    "test:matrix": "node scripts/test-matrix.mjs",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "check": "npm run lint && npm run typecheck && npm run test:unit",
    "check:full": "npm run lint && npm run typecheck && npm run test:unit && npm run test:integration && npm run test:e2e",
    "shots": "node scripts/shots.mjs",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "gsap": "^3.15.0",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "oxlint": "^1.87.0",
    "playwright": "^1.64.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
